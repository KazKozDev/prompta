{
  "name": "prompta",
  "description": "Prompt generator for Claude, ChatGPT, Gemini and Grok: macOS app, CLI and MCP server",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "test": "node --test \"pipeline/**/*.test.ts\" \"mcp/**/*.test.ts\" \"eval/**/*.test.ts\" \"desktop/**/*.test.ts\"",
    "pipeline": "node pipeline/cli.ts",
    "eval": "node eval/run.ts",
    "typecheck": "tsc --noEmit",
    "audit": "node eval/audit.ts",
    "mcp": "node mcp/server.ts",
    "eval:exec": "node eval/execute.ts",
    "eval:regress": "node eval/regress.ts"
  },
  "devDependencies": {
    "@types/node": "^22.14.0",
    "typescript": "~5.7.2"
  }
}
